# Python: virtual environment, bytecode, tool caches
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# Editors and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local settings and secrets
.env
.env.local

# AI assistant files
.claude/
CLAUDE.md
CLAUDE.local.md
.claude.json
.anthropic/
.aider*
.cursor/

# Third-party models downloaded by scripts/fetch_assets.py (not redistributed)
src/gesture_bc/sim/assets/franka_emika_panda/
src/gesture_bc/sim/assets/franka_emika_panda.partial/
*.task

# Demonstrations, training runs, checkpoints. The leading "/" matters: a bare
# "data/" would also hide the src/gesture_bc/data/ package.
/data/
/runs/
*.hdf5
*.h5
*.pt
*.pth
*.ckpt

# Videos are never committed (a small GIF for the README is fine)
*.mp4
*.avi
*.mov
*.mkv
*.webm

# MuJoCo writes warnings to this file in the current directory
MUJOCO_LOG.TXT
